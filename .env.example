# Optional public origin; enables canonical URLs and sitemap generation.
# VITE_SITE_URL=https://your-domain.example

# Optional overrides for the shared P-F EmailJS delivery configuration.
# Direct sending uses the existing public identifiers by default.
# These are browser-visible EmailJS identifiers, not private API secrets.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
