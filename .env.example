# Optional public origin; enables canonical URLs and sitemap generation.
# VITE_SITE_URL=https://your-domain.example

# Optional EmailJS delivery. All three are required to enable direct sending.
# Without these, the form prepares an email in the visitor's email app.
# These are browser-visible EmailJS identifiers, not private API secrets.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
